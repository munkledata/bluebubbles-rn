{
  "name": "gator-rn",
  "version": "0.1.41",
  "main": "index.js",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "test:android:db": "node --test scripts/run-android-db-contract.test.mjs && node scripts/run-android-db-contract.mjs",
    "test:android:db:relaunch": "node --test scripts/run-android-db-relaunch.test.mjs && node scripts/run-android-db-relaunch.mjs",
    "test:android:db:wal-write-death": "node --test scripts/run-android-db-relaunch.test.mjs && node scripts/run-android-db-relaunch.mjs --active-wal-write-death",
    "test:android:db:active-migration-death": "node --test scripts/run-android-db-relaunch.test.mjs && node scripts/run-android-db-relaunch.mjs --active-migration-death",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage:ui": "jest --coverage --collectCoverageFrom='src/ui/**/*.{ts,tsx}' --collectCoverageFrom='!src/ui/**/index.ts' --coverageReporters=text --coverageReporters=json-summary",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src app",
    "check:toolchain": "node --test scripts/check-toolchain.test.mjs && node scripts/check-toolchain.mjs",
    "check:architecture": "node --test scripts/check-core-boundaries.test.mjs scripts/check-scheduled-recovery.test.mjs && node scripts/check-core-boundaries.mjs && node scripts/check-scheduled-recovery.mjs",
    "check:db-writes:fast": "node --test scripts/check-db-writes.test.mjs",
    "check:db-writes:full": "DB_WRITE_SCANNER_FULL=1 node --test scripts/check-db-writes.test.mjs",
    "reconcile:db-writes": "node scripts/check-db-writes.mjs --reconcile",
    "check:secret-hygiene": "node --test scripts/check-secret-hygiene.test.mjs && node scripts/check-secret-hygiene.mjs",
    "check:error-diagnostics": "node --test scripts/check-error-diagnostics.test.mjs && node scripts/check-error-diagnostics.mjs",
    "check:migrations": "node scripts/check-migrations.mjs && node --test scripts/check-migrations.test.mjs",
    "check:android-build": "node --test scripts/check-android-build.test.mjs && node scripts/check-android-build.mjs",
    "doctor": "expo-doctor",
    "release:prepare:patch": "npm version patch --no-git-tag-version",
    "release:android": "npm run release:android:local",
    "release:android:local": "npm run check:toolchain && GOOGLE_SERVICES_JSON=\"${GOOGLE_SERVICES_JSON:-$PWD/google-services.json}\" && test -f \"$GOOGLE_SERVICES_JSON\" && export GOOGLE_SERVICES_JSON && EAS_LOCAL_BUILD_PLUGIN_PATH=\"$(npx --yes --ignore-scripts --package eas-cli-local-build-plugin@21.5.0 -c 'command -v eas-cli-local-build-plugin')\" && test -x \"$EAS_LOCAL_BUILD_PLUGIN_PATH\" && export EAS_LOCAL_BUILD_PLUGIN_PATH && npx --yes --ignore-scripts --package eas-cli@21.5.0 -c 'unset npm_config_ignore_scripts npm_config_call npm_config_package npm_config_yes; exec eas build -p android --profile production --local --output ./gator-release.aab'",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@op-engineering/op-sqlite": "17.1.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-firebase/app": "25.1.0",
    "@react-native-firebase/messaging": "25.1.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.101.0",
    "drizzle-orm": "0.45.2",
    "expo": "~57.0.16",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.4",
    "expo-background-task": "~57.0.13",
    "expo-build-properties": "~57.0.14",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-contacts": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.15",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.13",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-local-authentication": "~57.0.2",
    "expo-media-library": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.15",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.13",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "jail-monkey": "3.0.0",
    "ky": "^1.7.2",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-image-colors": "2.6.0",
    "react-native-libsodium": "1.7.0",
    "react-native-notify-kit": "10.4.8",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "expo-doctor": "1.20.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "libsodium-wrappers": "^0.7.15",
    "libsodium-wrappers-sumo": "^0.7.16",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "19.2.3",
    "react-native-image-colors": {
      "file-type": "^21.3.1"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "@firebase/util@1.15.1": false,
    "better-sqlite3@12.11.1": true,
    "fsevents@2.3.3": false,
    "protobufjs@7.6.5": false,
    "react-native-libsodium@1.7.0": true,
    "unrs-resolver@1.12.2": true
  },
  "op-sqlite": {
    "sqlcipher": true,
    "fts5": true
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-notify-kit",
          "react-native-libsodium"
        ]
      }
    }
  }
}
