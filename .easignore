# EAS upload ignore list. When present, EAS uses THIS instead of .gitignore.
# Tracks .gitignore and also excludes Git metadata. Firebase config comes from the project-scoped
# GOOGLE_SERVICES_JSON secret file in every named EAS environment; never upload the local fallback.

node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (the example is deliberately safe and uploadable)
.env
.env.*
!.env.example

# Firebase Android config (supplied by the EAS secret file; local builds retain their fallback)
/google-services.json

# Google Play service-account key (eas submit reads it locally; never upload it)
play-service-account.json

# Play Store build artifacts (regenerated per release)
*.aab

# typescript
*.tsbuildinfo

# generated coverage output
coverage/

# Local AI-tool settings and scheduler state are not build inputs.
.claude/

# Local Expo module native build artifacts (regenerated by Gradle)
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/

# generated native folders (EAS regenerates from app.config.ts)
/ios
/android

# git (no trailing slash: EAS checks the directory name itself before copying)
.git
