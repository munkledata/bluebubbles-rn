{
  "cli": {
    "version": "21.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "environment": "production",
      "node": "24.19.0"
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "env": { "GATOR_ANDROID_ARCHITECTURES": "arm64-v8a,x86_64" },
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug -PreactNativeArchitectures=arm64-v8a,x86_64"
      }
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "env": { "GATOR_ANDROID_ARCHITECTURES": "arm64-v8a,x86_64" },
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a,x86_64"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "env": { "GATOR_ANDROID_ARCHITECTURES": "arm64-v8a" },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease -PreactNativeArchitectures=arm64-v8a"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "serviceAccountKeyPath": "./play-service-account.json"
      }
    }
  }
}
