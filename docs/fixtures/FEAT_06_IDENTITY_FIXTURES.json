{
  "version": 1,
  "policy": {
    "conversationKey": "account-data-realm + provider + required-provider-epoch + exact-source-conversation-id",
    "supportedProviders": ["apple_messages", "google_messages"],
    "transports": ["imessage", "sms", "mms", "rcs", "unknown"],
    "contactPresentationOnly": true,
    "mergeDistinctTranscripts": false,
    "mergeDifferentNumbers": false,
    "mergeRcsWithAppleMessages": false
  },
  "cases": [
    {
      "id": "same-exact-chat-on-two-pages",
      "left": {
        "accountRealm": "account-a",
        "provider": "apple_messages",
        "transport": "imessage",
        "chatGuid": "iMessage;-;+15550000001",
        "address": "+15550000001",
        "snapshotToken": "snapshot-exact-chat",
        "page": 1
      },
      "right": {
        "accountRealm": "account-a",
        "provider": "apple_messages",
        "transport": "imessage",
        "chatGuid": "iMessage;-;+15550000001",
        "address": "+15550000001",
        "snapshotToken": "snapshot-exact-chat",
        "page": 2
      },
      "expected": {
        "relation": "same-conversation",
        "shareTranscript": true,
        "shareConversationState": true,
        "routeByContactMatch": false,
        "disposition": "deduplicate-exact-key"
      }
    },
