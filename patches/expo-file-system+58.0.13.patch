+package expo.modules.filesystem.legacy
+
+import expo.modules.kotlin.records.Field
+import expo.modules.kotlin.records.Record
+import java.io.File
+import okhttp3.MediaType.Companion.toMediaTypeOrNull
+import okhttp3.MultipartBody
+import okhttp3.RequestBody.Companion.asRequestBody
+
+/** Gator Android extension: one more local file sent in the same multipart upload. */
+data class GatorUploadFile(
+  @Field
+  val uri: String = "",
+  @Field
+  val fileName: String = "",
+  @Field
+  val mimeType: String = ""
+) : Record
+
+/** A checked extra file: an existing regular file, its validated basename and its type. */
+internal data class GatorUploadPart(val file: File, val fileName: String, val mimeType: String)
+
+/** Several files in one multipart form: the main file first, then these, in order, one field. */
+internal object GatorUploadFiles {
+  /** The server takes at most ten files in one message: the main file plus nine more. */
+  const val MAX_ADDITIONAL_FILES = 9
+
+  fun requireBounded(count: Int, multipart: Boolean) {
+    require(count == 0 || multipart) { "Gator additional files need a multipart upload" }
+    require(count <= MAX_ADDITIONAL_FILES) { "Too many Gator upload files" }
+  }
+
+  fun part(file: File, fileName: String, mimeType: String): GatorUploadPart {
+    require(file.isFile) { "Gator upload file is missing" }
+    require(mimeType.isNotBlank() && mimeType.toMediaTypeOrNull() != null) { "Invalid Gator upload file type" }
+    return GatorUploadPart(file, GatorUploadFilename.validate(fileName), mimeType)
+  }
+
+  fun addParts(builder: MultipartBody.Builder, fieldName: String, parts: List<GatorUploadPart>) {
+    for (part in parts) {
+      builder.addFormDataPart(fieldName, part.fileName, part.file.asRequestBody(part.mimeType.toMediaTypeOrNull()))
+    }
+  }
+}
