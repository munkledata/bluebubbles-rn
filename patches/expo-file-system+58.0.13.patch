+package expo.modules.filesystem.legacy
+
+import java.io.File
+import java.nio.file.Files
+import java.util.concurrent.TimeUnit
+import okhttp3.MultipartBody
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody
+import okhttp3.mockwebserver.MockResponse
+import okhttp3.mockwebserver.MockWebServer
+import okio.Buffer
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class GatorUploadMultipartTest {
+  private fun requestBody(
+    options: FileSystemUploadOptions,
+    file: File,
+    additionalParts: List<GatorUploadPart>,
+    decorator: RequestBodyDecorator
+  ): RequestBody {
+    val method = FileSystemLegacyModule::class.java.getDeclaredMethod(
+      "createRequestBody", FileSystemUploadOptions::class.java, RequestBodyDecorator::class.java, File::class.java, List::class.java
+    )
+    method.isAccessible = true
+    return method.invoke(FileSystemLegacyModule(), options, decorator, file, additionalParts) as RequestBody
+  }
+
+  private fun body(file: File, name: String?, binary: Boolean = false): RequestBody {
+    val options = FileSystemUploadOptions(
+      headers = null,
+      uploadType = if (binary) FileSystemUploadType.BINARY_CONTENT else FileSystemUploadType.MULTIPART,
+      fieldName = "attachment",
+      mimeType = "application/pdf",
+      parameters = mapOf("text" to "caption"),
+      gatorFileName = name
+    )
+    var decorated = 0
+    val result = requestBody(options, file, emptyList()) {
+      decorated += 1
+      assertEquals(file.length(), it.contentLength())
+      it
+    }
+    assertEquals(1, decorated)
+    return result
+  }
+
+  private fun multipartOptions(parameters: Map<String, String>) = FileSystemUploadOptions(
+    headers = null,
+    uploadType = FileSystemUploadType.MULTIPART,
+    fieldName = "attachment",
+    mimeType = "image/jpeg",
+    parameters = parameters,
+    gatorFileName = "IMG_0001.JPG"
+  )
+
+  private fun legacyClient(): OkHttpClient {
+    val getter = FileSystemLegacyModule::class.java.getDeclaredMethod("getOkHttpClient")
+    getter.isAccessible = true
+    return requireNotNull(getter.invoke(FileSystemLegacyModule()) as? OkHttpClient)
+  }
+
+  @Test
+  fun `metadata override preserves file bytes and the progress decorator`() {
+    val file = File.createTempFile("uuid-copy", ".pdf")
+    try {
+      file.writeText("%PDF-1.4\nGator disposable fixture\n")
+      for (name in listOf("original report.pdf", "résumé 📄.pdf", "résumé.pdf", "literal%22.pdf", "literal%20.pdf")) {
+        val body = body(file, name) as MultipartBody
+        val part = body.part(1)
+        assertEquals("form-data; name=\"attachment\"; filename=\"$name\"", part.headers?.get("Content-Disposition"))
+        assertEquals("application/pdf", part.body.contentType().toString())
+        val contents = Buffer()
+        part.body.writeTo(contents)
+        assertEquals(file.readText(), contents.readUtf8())
+        val wire = Buffer()
+        body.writeTo(wire)
+        assertTrue(wire.readUtf8().contains("filename=\"$name\""))
+      }
+      assertTrue(file.exists())
+    } finally {
+      file.delete()
+    }
+  }
+
+  @Test
+  fun `omitted override keeps the legacy basename and binary uploads ignore it`() {
+    val file = File.createTempFile("uuid-copy", ".pdf")
+    try {
+      file.writeText("owned bytes")
+      val multipart = body(file, null) as MultipartBody
+      assertEquals("form-data; name=\"attachment\"; filename=\"${file.name}\"", multipart.part(1).headers?.get("Content-Disposition"))
+      val binary = body(file, "../ignored", binary = true)
+      assertNull(binary.contentType())
+      val contents = Buffer()
+      binary.writeTo(contents)
+      assertEquals("owned bytes", contents.readUtf8())
+    } finally {
+      file.delete()
+    }
+  }
+
+  @Test
+  fun `several files follow the text fields in order and progress counts the whole form`() {
+    val first = File.createTempFile("uuid-a", ".jpg")
+    val second = File.createTempFile("uuid-b", ".heic")
+    val third = File.createTempFile("uuid-c", ".mov")
+    try {
+      first.writeText("first photo bytes")
+      second.writeText("second photo bytes, a little longer")
+      third.writeText("third")
+      val parts = listOf(
+        GatorUploadFiles.part(second, "IMG_0002.HEIC", "image/heic"),
+        GatorUploadFiles.part(third, "clip 📹.mov", "video/quicktime")
+      )
+      val decorated = mutableListOf<RequestBody>()
+      val options = multipartOptions(mapOf("chatGuid" to "any;+;chat1", "tempGuid" to "temp-1", "text" to "trip"))
+      val body = requestBody(options, first, parts) {
+        decorated.add(it)
+        it
+      } as MultipartBody
+      // One decoration, over the whole form: the progress bar spans every file.
+      assertEquals(1, decorated.size)
+      assertTrue(decorated[0] === body)
+      assertEquals(6, body.size)
+      for ((index, field) in listOf("chatGuid", "tempGuid", "text").withIndex()) {
+        assertEquals("form-data; name=\"$field\"", body.part(index).headers?.get("Content-Disposition"))
+      }
+      val expected = listOf(
+        Triple("IMG_0001.JPG", "image/jpeg", first),
+        Triple("IMG_0002.HEIC", "image/heic", second),
+        Triple("clip 📹.mov", "video/quicktime", third)
+      )
+      expected.forEachIndexed { index, (name, type, file) ->
+        val part = body.part(3 + index)
+        assertEquals("form-data; name=\"attachment\"; filename=\"$name\"", part.headers?.get("Content-Disposition"))
+        assertEquals(type, part.body.contentType().toString())
+        val contents = Buffer()
+        part.body.writeTo(contents)
+        assertEquals(file.readText(), contents.readUtf8())
+      }
+      val wire = Buffer()
+      body.writeTo(wire)
+      assertEquals(wire.size, body.contentLength())
+    } finally {
+      first.delete()
+      second.delete()
+      third.delete()
+    }
+  }
+
+  @Test
+  fun `a real request carries every file and its progress never goes backwards`() {
+    val server = MockWebServer()
+    server.enqueue(MockResponse().setResponseCode(200).setBody("{}"))
+    server.start()
+    val first = File.createTempFile("uuid-a", ".jpg")
+    val second = File.createTempFile("uuid-b", ".png")
+    try {
+      first.writeBytes(ByteArray(64 * 1024) { index -> (index % 251).toByte() })
+      second.writeBytes(ByteArray(32 * 1024) { index -> (index % 241).toByte() })
+      val progress = mutableListOf<Pair<Long, Long>>()
+      val options = multipartOptions(mapOf("chatGuid" to "iMessage;-;+15550100", "tempGuid" to "temp-2"))
+      val body = requestBody(options, first, listOf(GatorUploadFiles.part(second, "second.png", "image/png"))) {
+        CountingRequestBody(it, object : CountingRequestListener {
+          override fun onProgress(bytesWritten: Long, contentLength: Long) {
+            progress.add(bytesWritten to contentLength)
+          }
+        })
+      }
+      val total = body.contentLength()
+      assertTrue(total > first.length() + second.length())
+      val request = Request.Builder().url(server.url("/message/attachments/upload")).post(body).build()
+
+      legacyClient().newCall(request).execute().use { response ->
+        assertEquals(200, response.code)
+      }
+
+      val recorded = server.takeRequest(5, TimeUnit.SECONDS)
+      assertNotNull(recorded)
+      assertEquals(total, recorded!!.bodySize)
+      val wire = String(recorded.body.readByteArray(), Charsets.ISO_8859_1)
+      val firstAt = wire.indexOf("filename=\"IMG_0001.JPG\"")
+      val secondAt = wire.indexOf("filename=\"second.png\"")
+      assertTrue(wire.indexOf("name=\"tempGuid\"") in 0 until firstAt)
+      assertTrue(firstAt in 0 until secondAt)
+      assertEquals(total to total, progress.last())
+      assertTrue(progress.all { (_, expected) -> expected == total })
+      assertTrue(progress.zipWithNext().all { (before, after) -> after.first >= before.first })
+    } finally {
+      server.shutdown()
+      first.delete()
+      second.delete()
+    }
+  }
+
+  @Test
+  fun `extra files need a real file, a safe name, a type and a bounded multipart form`() {
+    val file = File.createTempFile("uuid-x", ".jpg")
+    val folder = Files.createTempDirectory("gator-upload").toFile()
+    try {
+      file.writeText("x")
+      for (name in listOf("", ".", "..", "../escape.jpg", "a/b.jpg", "a\\b.jpg", "quote\".jpg", "line\nbreak.jpg", "x".repeat(256))) {
+        assertThrows(IllegalArgumentException::class.java) { GatorUploadFiles.part(file, name, "image/jpeg") }
+      }
+      for (type in listOf("", "   ", "not a type")) {
+        assertThrows(IllegalArgumentException::class.java) { GatorUploadFiles.part(file, "ok.jpg", type) }
+      }
+      assertThrows(IllegalArgumentException::class.java) { GatorUploadFiles.part(folder, "ok.jpg", "image/jpeg") }
+      assertThrows(IllegalArgumentException::class.java) { GatorUploadFiles.part(File(file.path + ".gone"), "ok.jpg", "image/jpeg") }
+      assertEquals("ok 📷.jpg", GatorUploadFiles.part(file, "ok 📷.jpg", "image/jpeg").fileName)
+
+      GatorUploadFiles.requireBounded(0, multipart = false)
+      GatorUploadFiles.requireBounded(GatorUploadFiles.MAX_ADDITIONAL_FILES, multipart = true)
+      assertEquals(9, GatorUploadFiles.MAX_ADDITIONAL_FILES)
+      assertThrows(IllegalArgumentException::class.java) { GatorUploadFiles.requireBounded(10, multipart = true) }
+      assertThrows(IllegalArgumentException::class.java) { GatorUploadFiles.requireBounded(1, multipart = false) }
+    } finally {
+      file.delete()
+      folder.delete()
+    }
+  }
+}
