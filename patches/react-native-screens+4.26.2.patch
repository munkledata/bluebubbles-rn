+package com.swmansion.rnscreens.gamma.stack.host
+
+import android.app.Application
+import com.facebook.react.bridge.BridgeReactContext
+import com.facebook.react.uimanager.ThemedReactContext
+import com.swmansion.rnscreens.gamma.stack.screen.StackScreen
+import com.swmansion.rnscreens.gamma.stack.screen.StackScreenFragment
+import java.lang.ref.WeakReference
+import java.lang.reflect.InvocationTargetException
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertThrows
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+
+/**
+ * Exercises the actual coordinator and container computation, without committing FragmentManager
+ * transactions or starting a React runtime. Device replay still owns animation/Back integration.
+ */
+@RunWith(RobolectricTestRunner::class)
+// API 36's Robolectric image requires JDK 21; this ordering logic uses no API 36 behavior.
+@Config(manifest = Config.NONE, sdk = [35], application = Application::class)
+@Suppress("DEPRECATION")
+class StackContainerPopOrderTest {
+    private lateinit var reactContext: ThemedReactContext
+    private lateinit var container: StackContainer
+
+    @Before
+    fun setUp() {
+        val application = RuntimeEnvironment.getApplication<Application>()
+        // A context wrapper only: no Catalyst instance, JS queues, or native runtime is started.
+        reactContext = ThemedReactContext(BridgeReactContext(application), application, "stack-test", 1)
+        val delegate =
+            object : StackContainerDelegate {
+                override fun onScreenDismissCommitted(stackScreen: StackScreen) = Unit
+            }
+        container = StackContainer(application, WeakReference<StackContainerDelegate>(delegate))
+    }
+
+    @Test
+    fun firstPushCreatesRootWithoutPop() {
+        val root = screen("folders")
+        container.enqueuePushOperation(root)
+
+        applyOperations()
+
+        assertEquals(listOf(root), screens())
+        val add = operations().filterIsInstance<AddAndSetAsPrimaryOp>().single()
+        assertSame(root, add.fragment.stackScreen)
+        assertFalse(add.addToBackStack)
+    }
+
+    @Test
+    fun removedEditorAndBrowserPopInCommittedOrder() {
+        val (root, browse, editor) = commit("folders", "browse", "editor")
+        val coordinator = StackContainerUpdateCoordinator()
+        // Fabric removes tail children in descending order. Neither removed child is rendered now.
+        coordinator.addPopOperation(editor)
+        coordinator.addPopOperation(browse)
+        coordinator.executePendingOperationsIfNeeded(container, listOf(root))
+
+        applyOperations()
+
+        assertEquals(listOf(root), screens())
+        assertEquals(listOf(editor, browse), poppedScreens())
+    }
+
+    @Test
+    fun reverseIncomingOrderStillUsesCommittedStack() {
+        val (root, browse, editor) = commit("folders", "browse", "editor")
+        container.enqueuePopOperation(browse)
+        container.enqueuePopOperation(editor)
+
+        applyOperations()
+
+        assertEquals(listOf(root), screens())
+        assertEquals(listOf(editor, browse), poppedScreens())
+    }
+
+    @Test
+    fun threePopsMayArriveInMixedOrder() {
+        val (root, first, second, third) = commit("root", "first", "second", "third")
+        listOf(second, first, third).forEach(container::enqueuePopOperation)
+
+        applyOperations()
+
+        assertEquals(listOf(root), screens())
+        assertEquals(listOf(third, second, first), poppedScreens())
+    }
+
+    @Test
+    fun batchesAccumulatedWhileUnattachedAreOrderedTogether() {
+        val (root, browse, editor) = commit("folders", "browse", "editor")
+        val coordinator = StackContainerUpdateCoordinator()
+        coordinator.addPopOperation(browse)
+        coordinator.executePendingOperationsIfNeeded(container, listOf(root, editor))
+        coordinator.addPopOperation(editor)
+        coordinator.executePendingOperationsIfNeeded(container, listOf(root))
+        assertEquals(listOf(root, browse, editor), screens())
+
+        applyOperations()
+
+        assertEquals(listOf(root), screens())
+        assertEquals(listOf(editor, browse), poppedScreens())
+    }
+
+    @Test
+    fun ordinaryTopPopAndPushRetainTheirExistingOrder() {
+        val (root, old) = commit("root", "old")
+        val replacement = screen("new")
+        container.enqueuePushOperation(replacement)
+        container.enqueuePopOperation(old)
+
+        applyOperations()
+
+        assertEquals(listOf(root, replacement), screens())
+        assertEquals(listOf(old), poppedScreens())
+        assertTrue(operations().filterIsInstance<AddAndSetAsPrimaryOp>().single().addToBackStack)
+    }
+
+    @Test
+    fun sameBatchTransientScreenCancelsBeforeMultiPopValidation() {
+        val (root, browse, editor) = commit("folders", "browse", "editor")
+        val transient = screen("transient")
+        container.enqueuePushOperation(transient)
+        listOf(browse, transient, editor).forEach(container::enqueuePopOperation)
+
+        applyOperations()
+
+        assertEquals(listOf(root), screens())
+        assertEquals(listOf(editor, browse), poppedScreens())
+        assertTrue(operations().none { it is AddAndSetAsPrimaryOp || it is RemoveOp })
+    }
+
+    @Test
+    fun transientOnlyBatchLeavesNoFragmentOperations() {
+        val (root) = commit("root")
+        val transient = screen("transient")
+        container.enqueuePushOperation(transient)
+        container.enqueuePopOperation(transient)
+
+        applyOperations()
+
+        assertEquals(listOf(root), screens())
+        assertTrue(operations().isEmpty())
+    }
+
+    @Test
+    fun exactSoleRootReplacementUsesDirectRemoval() {
+        val (old) = commit("old")
+        val replacement = screen("replacement")
+        container.enqueuePopOperation(old)
+        container.enqueuePushOperation(replacement)
+
+        applyOperations()
+
+        assertEquals(listOf(replacement), screens())
+        assertSame(old, operations().filterIsInstance<RemoveOp>().single().fragment.stackScreen)
+        assertTrue(poppedScreens().isEmpty())
+        assertFalse(operations().filterIsInstance<AddAndSetAsPrimaryOp>().single().addToBackStack)
+    }
+
+    @Test
+    fun unknownPopFailsBeforeAnyCommittedMutation() {
+        val (_, top) = commit("root", "top")
+        container.enqueuePopOperation(top)
+        container.enqueuePopOperation(screen("unknown"))
+
+        assertAtomicFailure("[RNScreens] Unable to find a fragment to pop")
+    }
+
+    @Test
+    fun equalScreenKeysDoNotSubstituteForIdentity() {
+        commit("root", "top")
+        container.enqueuePopOperation(screen("top"))
+
+        assertAtomicFailure("[RNScreens] Unable to find a fragment to pop")
+    }
+
+    @Test
+    fun duplicatePopFailsBeforeAnyCommittedMutation() {
+        val (_, top) = commit("root", "top")
+        container.enqueuePopOperation(top)
+        container.enqueuePopOperation(top)
+
+        assertAtomicFailure("[RNScreens] Attempt to pop the same screen more than once")
+    }
+
+    @Test
+    fun missingTopPopIsRejected() {
+        val (_, middle, _) = commit("root", "middle", "top")
+        container.enqueuePopOperation(middle)
+
+        assertAtomicFailure("[RNScreens] Attempt to pop non-top screen")
+    }
+
+    @Test
+    fun gapBelowValidTopIsRejectedBeforeTopIsRemoved() {
+        val (_, first, _, top) = commit("root", "first", "second", "top")
+        container.enqueuePopOperation(top)
+        container.enqueuePopOperation(first)
+
+        assertAtomicFailure("[RNScreens] Attempt to pop non-top screen")
+    }
+
+    @Test
+    fun removingSoleRootWithoutReplacementIsRejected() {
+        val (root) = commit("root")
+        container.enqueuePopOperation(root)
+
+        assertAtomicFailure("[RNScreens] Attempt to pop last screen from the stack")
+    }
+
+    @Test
+    fun fullStackPopWithNewRootDoesNotBroadenRootReplacement() {
+        val (root, top) = commit("root", "top")
+        container.enqueuePopOperation(top)
+        container.enqueuePopOperation(root)
+        container.enqueuePushOperation(screen("new"))
+
+        assertAtomicFailure("[RNScreens] Attempt to pop last screen from the stack")
+    }
+
+    @Test
+    fun rootReplacementRejectsSameIdentity() {
+        val (root) = commit("root")
+        container.enqueuePopOperation(root)
+        container.enqueuePushOperation(root)
+
+        assertAtomicFailure("[RNScreens] Attempt to pop last screen from the stack")
+    }
+
+    @Test
+    fun rootReplacementRejectsMultiplePushes() {
+        val (root) = commit("root")
+        container.enqueuePopOperation(root)
+        container.enqueuePushOperation(screen("first"))
+        container.enqueuePushOperation(screen("second"))
+
+        assertAtomicFailure("[RNScreens] Attempt to pop last screen from the stack")
+    }
+
+    private fun screen(key: String): StackScreen = StackScreen(reactContext).apply { screenKey = key }
+
+    private fun commit(vararg keys: String): List<StackScreen> =
+        keys.map(::screen).also { created ->
+            created.forEach(container::enqueuePushOperation)
+            applyOperations()
+        }
+
+    private fun assertAtomicFailure(message: String) {
+        val beforeScreens = screens()
+        val beforeOperations = operations()
+        val error = assertThrows(IllegalStateException::class.java) { applyOperations() }
+        assertEquals(message, error.message)
+        assertEquals(beforeScreens, screens())
+        assertEquals(beforeOperations, operations())
+    }
+
+    private fun applyOperations() {
+        val method = StackContainer::class.java.getDeclaredMethod("applyOperationsAndComputeFragmentManagerOperations")
+        method.isAccessible = true
+        try {
+            method.invoke(container)
+        } catch (error: InvocationTargetException) {
+            throw error.targetException
+        }
+    }
+
+    @Suppress("UNCHECKED_CAST")
+    private fun screens(): List<StackScreen> {
+        val field = StackContainer::class.java.getDeclaredField("stackModel")
+        field.isAccessible = true
+        return (field.get(container) as List<StackScreenFragment>).map { it.stackScreen }
+    }
+
+    @Suppress("UNCHECKED_CAST")
+    private fun operations(): List<FragmentOperation> {
+        val field = StackContainer::class.java.getDeclaredField("fragmentOps")
+        field.isAccessible = true
+        return (field.get(container) as List<FragmentOperation>).toList()
+    }
+
+    private fun poppedScreens(): List<StackScreen> =
+        operations().filterIsInstance<PopBackStackOp>().map { it.fragment.stackScreen }
+}
