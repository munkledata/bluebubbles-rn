+package expo.modules.backgroundtask
+
+import kotlin.coroutines.coroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.withTimeoutOrNull
+
+internal const val BACKGROUND_TASK_NATIVE_DEADLINE_MS = 60_000L
+
+/** Bounds cooperative native suspension independently of JavaScript timers; never clears ownership. */
+internal suspend fun runBackgroundTaskWithDeadline(
+  onTimeout: () -> Unit,
+  runTasks: suspend () -> Boolean
+): Boolean {
+  // Only this timeout becomes null. A nested timeout or external worker cancellation propagates.
+  val result = withTimeoutOrNull(BACKGROUND_TASK_NATIVE_DEADLINE_MS) { runTasks() }
+  coroutineContext.ensureActive()
+  if (result == null) {
+    onTimeout()
+    return false
+  }
+  return result
+}
