+package expo.modules.backgroundtask
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitCancellation
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.test.advanceTimeBy
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.withTimeout
+import org.junit.Assert.*
+import org.junit.Test
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class BackgroundTaskDeadlineTest {
+  @Test
+  fun ownDeadlineReturnsRetryAtSixtySeconds() = runTest {
+    var timeouts = 0
+    val result = async {
+      runBackgroundTaskWithDeadline({ timeouts += 1 }) { awaitCancellation() }
+    }
+    runCurrent()
+    advanceTimeBy(59_999)
+    runCurrent()
+    assertFalse(result.isCompleted)
+    advanceTimeBy(1)
+    runCurrent()
+    assertFalse(result.await())
+    assertEquals(1, timeouts)
+  }
+
+  @Test
+  fun normalSuccessAndFailurePreserveTheirResultWithoutTimeout() = runTest {
+    for (expected in listOf(true, false)) {
+      val actual = runBackgroundTaskWithDeadline({ fail("unexpected timeout") }) {
+        delay(10)
+        expected
+      }
+      assertEquals(expected, actual)
+    }
+  }
+
+  @Test
+  fun externalCancellationPropagatesWithoutBecomingRetry() = runTest {
+    var timeouts = 0
+    var returned = false
+    val result = async {
+      runBackgroundTaskWithDeadline({ timeouts += 1 }) { awaitCancellation() }
+      returned = true
+    }
+    runCurrent()
+    result.cancel(CancellationException("test stop"))
+    runCurrent()
+    assertTrue(result.isCancelled)
+    assertFalse(returned)
+    assertEquals(0, timeouts)
+  }
+
+  @Test
+  fun nestedTimeoutIsNotMistakenForTheNativeDeadline() = runTest {
+    var timeouts = 0
+    val result = async {
+      runBackgroundTaskWithDeadline({ timeouts += 1 }) {
+        withTimeout(100) { awaitCancellation() }
+      }
+    }
+    runCurrent()
+    advanceTimeBy(100)
+    runCurrent()
+    assertTrue(result.isCancelled)
+    assertEquals(0, timeouts)
+  }
+
+  @Test
+  fun ownTimeoutCancelsBeforeResultAndRetainsLateCallbackAndContinuation() = runTest {
+    val registry = BackgroundTaskExecutionRegistry()
+    val execution = registry.begin("a")!!
+    val consumer = registry.registerConsumer(execution)!!
+    val claim = registry.retain(execution.id, "a", "event")!!
+    val callback = CompletableDeferred<Boolean>()
+    val order = mutableListOf<String>()
+    val result = async {
+      runBackgroundTaskWithDeadline({ order.add("retry") }) {
+        try {
+          callback.await()
+        } catch (error: CancellationException) {
+          registry.cancel(execution)
+          order.add("cancel")
+          throw error
+        } finally {
+          registry.finishDispatch(execution)
+        }
+      }
+    }
+    runCurrent()
+    advanceTimeBy(60_000)
+    runCurrent()
+    assertFalse(result.await())
+    assertEquals(listOf("cancel", "retry"), order)
+    assertTrue(execution.cancelled)
+    assertNull(registry.begin("a"))
+    callback.complete(true)
+    registry.completeConsumer(execution, consumer)
+    assertNull(registry.begin("a"))
+    assertTrue(registry.release(execution.id, "a", "event", claim["leaseToken"] as String))
+    val next = registry.begin("a")!!
+    registry.cancel(execution)
+    registry.finishDispatch(execution)
+    assertFalse(next.cancelled)
+  }
+
+  @Test
+  fun timeoutBeforeJavascriptClaimLatchesUntilPendingConsumerSettles() = runTest {
+    val registry = BackgroundTaskExecutionRegistry()
+    val execution = registry.begin("a")!!
+    val consumer = registry.registerConsumer(execution)!!
+    val result = async {
+      runBackgroundTaskWithDeadline({}) {
+        try {
+          awaitCancellation()
+        } catch (error: CancellationException) {
+          registry.cancel(execution)
+          throw error
+        } finally {
+          registry.finishDispatch(execution)
+        }
+      }
+    }
+    runCurrent()
+    advanceTimeBy(60_000)
+    runCurrent()
+    assertFalse(result.await())
+    assertNull(registry.begin("a"))
+    val lateClaim = registry.retain(execution.id, "a", "event")!!
+    assertEquals(true, lateClaim["cancelled"])
+    registry.completeConsumer(execution, consumer)
+    assertNull(registry.begin("a"))
+    assertTrue(registry.release(execution.id, "a", "event", lateClaim["leaseToken"] as String))
+    assertNotNull(registry.begin("a"))
+  }
+}
