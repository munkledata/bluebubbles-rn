+    val firstOwner = Any()
+    val nextOwner = Any()
+    val calls = mutableListOf<String>()
+    registry.observe(firstOwner) { calls.add("old") }
+    registry.observe(nextOwner) { calls.add(it) }
+    val execution = registry.begin("a")!!
+    registry.registerConsumer(execution)
+    registry.cancel(execution)
+    registry.cancel(execution)
+    assertEquals(setOf("old", execution.id), calls.toSet())
+    assertEquals(2, calls.size)
+    registry.removeObserver(nextOwner)
+    assertEquals(true, registry.retain(execution.id, "a", "event")!!["cancelled"])
+  }
