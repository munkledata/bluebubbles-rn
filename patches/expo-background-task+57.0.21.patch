+package expo.modules.backgroundtask
+
+import java.util.UUID
+import java.util.WeakHashMap
+
+/** One process-local owner, retained until dispatched callbacks and their real continuations settle. */
+internal class BackgroundTaskExecutionRegistry {
+  internal class Execution(val scope: String) {
+    val id: String = UUID.randomUUID().toString()
+    var cancelled = false
+    var dispatchFinished = false
+    var issuedConsumers = 0
+    val consumers = mutableSetOf<Any>()
+    val retainedEvents = mutableMapOf<String, String>()
+  }
+
+  private var current: Execution? = null
+  private val listeners = WeakHashMap<Any, (String) -> Unit>()
+
+  @Synchronized
+  fun begin(scope: String): Execution? {
+    if (current != null) return null
+    return Execution(scope).also { current = it }
+  }
+
+  @Synchronized
+  fun registerConsumer(execution: Execution): Any? {
+    if (current !== execution || execution.cancelled || execution.dispatchFinished) return null
+    execution.issuedConsumers += 1
+    return Any().also { execution.consumers.add(it) }
+  }
+
+  @Synchronized
+  fun completeConsumer(execution: Execution, consumer: Any) {
+    if (current !== execution || !execution.consumers.remove(consumer)) return
+    releaseIfSettled(execution)
+  }
+
+  @Synchronized
+  fun finishDispatch(execution: Execution) {
+    if (current !== execution) return
+    execution.dispatchFinished = true
+    releaseIfSettled(execution)
+  }
+
+  @Synchronized
+  fun retain(id: String, scope: String, eventId: String): Map<String, Any>? {
+    val execution = current ?: return null
+    if (execution.id != id || execution.scope != scope || execution.consumers.isEmpty() ||
+      execution.retainedEvents.containsKey(eventId) ||
+      execution.retainedEvents.size >= execution.issuedConsumers) return null
+    val leaseToken = UUID.randomUUID().toString()
+    execution.retainedEvents[eventId] = leaseToken
+    return mapOf("leaseToken" to leaseToken, "cancelled" to execution.cancelled)
+  }
+
+  @Synchronized
+  fun release(id: String, scope: String, eventId: String, leaseToken: String): Boolean {
+    val execution = current ?: return false
+    if (execution.id != id || execution.scope != scope ||
+      execution.retainedEvents[eventId] != leaseToken) return false
+    execution.retainedEvents.remove(eventId)
+    releaseIfSettled(execution)
+    return true
+  }
+
+  fun cancel(execution: Execution) {
+    val notify = synchronized(this) {
+      if (current !== execution || execution.cancelled) return
+      // Latch before notification: JavaScript may not have a context/listener yet.
+      execution.cancelled = true
+      listeners.values.toList()
+    }
+    notify.forEach { it(execution.id) }
+  }
+
+  @Synchronized
+  fun observe(owner: Any, notify: (String) -> Unit) {
+    listeners[owner] = notify
+  }
+
+  @Synchronized
+  fun removeObserver(owner: Any) {
+    listeners.remove(owner)
+  }
+
+  private fun releaseIfSettled(execution: Execution) {
+    if (execution.dispatchFinished && execution.consumers.isEmpty() && execution.retainedEvents.isEmpty()) {
+      current = null
+    }
+  }
+}
+
+internal val backgroundTaskExecutions = BackgroundTaskExecutionRegistry()
