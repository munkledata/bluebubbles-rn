+      throw new AssertionError("Unexpected task unregistration");
+    }
+
+    @Override
+    public void executeTaskWithBody(Bundle body) {
+      throw new AssertionError("Unexpected queued event");
+    }
+
+    @Override
+    public boolean taskHasConsumerOfClass(String name, Class consumerClass) {
+      return false;
+    }
+
+    @Override
+    public void flushQueuedEvents() {}
+
+    @Override
+    public String getAppScopeKey() {
+      return scope;
+    }
+  }
+}
