+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+
+import expo.modules.apploader.AppLoaderProvider;
+import expo.modules.apploader.HeadlessAppLoader;
+import expo.modules.core.interfaces.Consumer;
+import expo.modules.interfaces.taskManager.TaskManagerInterface;
+import expo.modules.interfaces.taskManager.TaskExecutionCallback;
+import expo.modules.taskManager.repository.BareTasksAndEventsRepository;
+
+/** Exercises the real TaskService; only the app loader and JS managers are fakes. */
+@RunWith(RobolectricTestRunner.class)
+// Robolectric's API 36 image requires Java 21. These map-lifecycle transitions
+// use no API 36 behavior, so API 35 keeps the test runnable with the build's JDK 17.
+@Config(manifest = Config.NONE, sdk = 35, application = Application.class)
+public class TaskServiceContextLifetimeTest {
+  private final List<AutoCloseable> restorations = new ArrayList<>();
+  private final FakeLoader loader = new FakeLoader();
+  private final String scopeA = "context-lifetime-a-" + UUID.randomUUID();
+  private final String scopeB = "context-lifetime-b-" + UUID.randomUUID();
+  private Map<Object, Object> foregroundManagers;
+  private Map<Object, Object> headlessManagers;
+  private TaskService service;
+  private Map<Object, Object> executionEvents;
+  private Map<Object, Object> executionManagers;
+  private Map<Object, Object> executionCallbacks;
+  private Map<Object, Object> headlessStarts;
+  private Map<Object, Object> headlessOwners;
+
+  @Before
+  public void setUp() throws Exception {
+    Application application = RuntimeEnvironment.getApplication();
+    // TaskService's repository factory expects manifest metadata. Mutate the shadow's
+    // actual package record, rather than the copy returned by getApplicationInfo().
+    ApplicationInfo applicationInfo = shadowOf(application.getPackageManager())
+        .getInternalMutablePackageInfo(application.getPackageName()).applicationInfo;
+    Bundle originalMetadata = applicationInfo.metaData;
+    restorations.add(() -> applicationInfo.metaData = originalMetadata);
+    applicationInfo.metaData = originalMetadata == null
+        ? new Bundle() : new Bundle(originalMetadata);
+    applicationInfo.metaData.putBoolean("expo.modules.taskManager.oneAppId", true);
+
+    foregroundManagers = isolateMap(TaskService.class, "sTaskManagers");
+    headlessManagers = isolateMap(TaskService.class, "sHeadlessTaskManagers");
+    executionEvents = isolateMap(TaskService.class, "sEvents");
+    executionManagers = isolateMap(TaskService.class, "sExecutionManagers");
+    executionCallbacks = isolateMap(TaskService.class, "sTaskCallbacks");
+    headlessStarts = isolateMap(TaskService.class, "sHeadlessStartTokens");
+    headlessOwners = isolateMap(TaskService.class, "sHeadlessTaskOwners");
+    isolateMap(TaskService.class, "sRetainedExecutions");
+    isolateMap(AppLoaderProvider.class, "loaders").put("react-native-headless", loader);
+    // Non-null empty tasks avoid constructor restoration from shared preferences.
+    // Keep the original map objects and their contents intact for the next test.
+    replaceField(BareTasksAndEventsRepository.class, "sTasks", new HashMap<>());
+    replaceField(BareTasksAndEventsRepository.class, "sEvents", new HashMap<>());
+    service = new TaskService(application);
+  }
+
+  @After
+  public void tearDown() throws Exception {
+    Exception failure = null;
+    for (int index = restorations.size() - 1; index >= 0; index--) {
+      try {
+        restorations.get(index).close();
+      } catch (Exception error) {
+        if (failure == null) {
+          failure = error;
+        } else {
+          failure.addSuppressed(error);
+        }
+      }
+    }
+    restorations.clear();
+    if (failure != null) {
+      throw failure;
+    }
+  }
+
+  @Test
+  public void successfulLoaderInvalidationRetainsManagerUntilContextDestruction()
+      throws Exception {
+    assertInvalidationRetainsManager(true);
+  }
+
+  @Test
+  public void unsuccessfulLoaderInvalidationRetainsManagerUntilContextDestruction()
+      throws Exception {
+    assertInvalidationRetainsManager(false);
+  }
+
+  @Test
+  public void contextDestructionRemovesBothManagersOnlyForItsScope() throws Exception {
+    FakeManager foregroundA = register(scopeA, false);
+    FakeManager headlessA = register(scopeA, true);
+    FakeManager foregroundB = register(scopeB, false);
+    FakeManager headlessB = register(scopeB, true);
+    assertSame(foregroundA, resolveManager(scopeA));
+    assertSame(headlessA, storedManager(headlessManagers, scopeA));
+
+    service.setTaskManager(null, scopeA, null);
+
+    assertFalse(foregroundManagers.containsKey(scopeA));
+    assertFalse(headlessManagers.containsKey(scopeA));
+    assertNull(resolveManager(scopeA));
+    assertSame(foregroundB, resolveManager(scopeB));
+    assertSame(foregroundB, storedManager(foregroundManagers, scopeB));
+    assertSame(headlessB, storedManager(headlessManagers, scopeB));
+    assertTrue(loader.invalidatedScopes.isEmpty());
+  }
+
+  @Test
+  public void newHeadlessManagerCanRegisterAfterContextDestruction() throws Exception {
+    FakeManager oldManager = register(scopeA, true);
+    assertSame(oldManager, resolveManager(scopeA));
+    service.setTaskManager(null, scopeA, null);
+    assertNull(resolveManager(scopeA));
+
+    FakeManager newManager = register(scopeA, true);
+
+    assertSame(newManager, resolveManager(scopeA));
+    assertSame(newManager, storedManager(headlessManagers, scopeA));
+  }
+
+  @Test
+  public void resultIsDeliveredOnceWhileTheRealContinuationRetainsItsEvent() throws Exception {
+    FakeManager manager = register(scopeA, true);
+    AtomicInteger completions = new AtomicInteger();
+    String eventId = pendingEvent(scopeA, manager, completions);
+    Object generation = headlessStarts.get(scopeA);
+    String lease = service.retainTaskExecution(scopeA, eventId, manager);
+    assertNotNull(lease);
+    service.notifyTaskFinished("gator-bg-sync", scopeA, Collections.singletonMap("eventId", eventId));
+    service.notifyTaskFinished("gator-bg-sync", scopeA, Collections.singletonMap("eventId", eventId));
+    assertEquals(1, completions.get());
+    assertTrue(executionEvents.containsKey(scopeA));
+    assertSame(generation, headlessStarts.get(scopeA));
+    assertTrue(service.releaseTaskExecution(scopeA, eventId, lease, manager));
+    assertFalse(executionEvents.containsKey(scopeA));
+    assertFalse(headlessStarts.containsKey(scopeA));
+    assertEquals(1, completions.get());
+  }
+
+  @Test
+  public void releaseBeforeResultKeepsTheEventUntilResultArrives() throws Exception {
+    FakeManager manager = register(scopeA, true);
+    AtomicInteger completions = new AtomicInteger();
+    String eventId = pendingEvent(scopeA, manager, completions);
+    String lease = service.retainTaskExecution(scopeA, eventId, manager);
+    assertTrue(service.releaseTaskExecution(scopeA, eventId, lease, manager));
+    assertTrue(executionEvents.containsKey(scopeA));
+    assertEquals(0, completions.get());
+    service.notifyTaskFinished("gator-bg-sync", scopeA, Collections.singletonMap("eventId", eventId));
+    assertFalse(executionEvents.containsKey(scopeA));
+    assertEquals(1, completions.get());
+  }
+
+  @Test
+  public void foreignScopeManagerAndLeaseCannotRetainOrReleaseTheExecution() throws Exception {
+    FakeManager manager = register(scopeA, true);
+    FakeManager other = register(scopeB, true);
+    String eventId = pendingEvent(scopeA, manager, new AtomicInteger());
+    assertNull(service.retainTaskExecution(scopeB, eventId, manager));
+    assertNull(service.retainTaskExecution(scopeA, eventId, other));
+    assertNull(service.retainTaskExecution(scopeA, "missing", manager));
+    String lease = service.retainTaskExecution(scopeA, eventId, manager);
+    assertNull(service.retainTaskExecution(scopeA, eventId, manager));
+    assertFalse(service.releaseTaskExecution(scopeB, eventId, lease, manager));
+    assertFalse(service.releaseTaskExecution(scopeA, eventId, lease, other));
+    assertFalse(service.releaseTaskExecution(scopeA, eventId, "stale", manager));
+    service.notifyTaskFinished("gator-bg-sync", scopeA, Collections.singletonMap("eventId", eventId));
+    assertTrue(executionEvents.containsKey(scopeA));
+    assertTrue(service.releaseTaskExecution(scopeA, eventId, lease, manager));
+  }
+
+  @Test
+  public void oldReleaseCannotFinishANewerGeneration() throws Exception {
+    FakeManager manager = register(scopeA, true);
+    String oldEvent = pendingEvent(scopeA, manager, new AtomicInteger());
+    String oldLease = service.retainTaskExecution(scopeA, oldEvent, manager);
+    service.notifyTaskFinished("gator-bg-sync", scopeA, Collections.singletonMap("eventId", oldEvent));
+    assertTrue(service.releaseTaskExecution(scopeA, oldEvent, oldLease, manager));
+    String nextEvent = pendingEvent(scopeA, manager, new AtomicInteger());
+    Object nextGeneration = headlessStarts.get(scopeA);
+    assertFalse(service.releaseTaskExecution(scopeA, oldEvent, oldLease, manager));
+    service.notifyTaskFinished("gator-bg-sync", scopeA, Collections.singletonMap("eventId", oldEvent));
+    assertSame(nextGeneration, headlessStarts.get(scopeA));
+    assertTrue(((List<?>) executionEvents.get(scopeA)).contains(nextEvent));
+  }
+
+  @Test
+  public void finishingOldHeadlessTaskUsesItsOriginalContextWhenNumericIdsAreReused() throws Exception {
+    Application app = RuntimeEnvironment.getApplication();
+    HeadlessJsTaskContext oldContext = HeadlessJsTaskContext.getInstance(new BridgeReactContext(app));
+    HeadlessJsTaskContext newContext = HeadlessJsTaskContext.getInstance(new BridgeReactContext(app));
+    Field tasks = HeadlessJsTaskContext.class.getDeclaredField("activeTasks");
+    tasks.setAccessible(true);
+    ((Set<Integer>) tasks.get(oldContext)).add(7);
+    ((Set<Integer>) tasks.get(newContext)).add(7);
+    Class<?> ownerClass = Class.forName("expo.modules.taskManager.TaskService$HeadlessTaskOwner");
+    java.lang.reflect.Constructor<?> constructor = ownerClass.getDeclaredConstructor(HeadlessJsTaskContext.class, int.class);
+    constructor.setAccessible(true);
+    Object generation = new Object();
+    headlessOwners.put(generation, constructor.newInstance(oldContext, 7));
+    Method finish = TaskService.class.getDeclaredMethod("maybeFinishHeadlessTask", String.class, Object.class);
+    finish.setAccessible(true);
+    finish.invoke(service, scopeA, generation);
+    shadowOf(Looper.getMainLooper()).idle();
+    assertFalse(oldContext.isTaskRunning(7));
+    assertTrue(newContext.isTaskRunning(7));
+    newContext.finishTask(7);
+  }
+
+  private String pendingEvent(String scope, FakeManager manager, AtomicInteger completions) {
+    String eventId = UUID.randomUUID().toString();
+    executionEvents.put(scope, new ArrayList<>(Collections.singletonList(eventId)));
+    executionManagers.put(eventId, new WeakReference<>(manager));
+    executionCallbacks.put(eventId, (TaskExecutionCallback) response -> completions.incrementAndGet());
+    headlessStarts.put(scope, new Object());
+    return eventId;
+  }
+
+  private void assertInvalidationRetainsManager(boolean invalidationResult) throws Exception {
+    FakeManager manager = register(scopeA, true);
+    assertSame(manager, resolveManager(scopeA));
+    loader.invalidationResult = invalidationResult;
+
+    Method invalidate = TaskService.class.getDeclaredMethod("invalidateAppRecord", String.class);
+    invalidate.setAccessible(true);
+    invalidate.invoke(service, scopeA);
+
+    assertTrue(loader.invalidatedScopes.contains(scopeA));
+    assertSame(manager, storedManager(headlessManagers, scopeA));
+    assertSame(manager, resolveManager(scopeA));
+    service.setTaskManager(null, scopeA, null);
+    assertNull(resolveManager(scopeA));
+    assertFalse(headlessManagers.containsKey(scopeA));
+  }
+
+  private FakeManager register(String scope, boolean headless) {
+    if (headless) {
+      loader.runningScopes.add(scope);
+    } else {
+      loader.runningScopes.remove(scope);
+    }
+    FakeManager manager = new FakeManager(scope);
+    // Unique scope keys have no persisted config, so foreground registration only
+    // reads preferences and cannot rewrite a previous test's saved task config.
+    service.setTaskManager(manager, scope, "test://context-lifetime");
+    return manager;
+  }
+
+  private TaskManagerInterface resolveManager(String scope) throws Exception {
+    Method getManager = TaskService.class.getDeclaredMethod("getTaskManager", String.class);
+    getManager.setAccessible(true);
+    return (TaskManagerInterface) getManager.invoke(service, scope);
+  }
+
+  private static Object storedManager(Map<Object, Object> managers, String scope) {
+    WeakReference<?> reference = (WeakReference<?>) managers.get(scope);
+    return reference == null ? null : reference.get();
+  }
+
+  @SuppressWarnings("unchecked")
+  private Map<Object, Object> isolateMap(Class<?> owner, String name) throws Exception {
+    Field field = owner.getDeclaredField(name);
+    field.setAccessible(true);
+    Map<Object, Object> map = (Map<Object, Object>) field.get(null);
+    Map<Object, Object> originalContents = new HashMap<>(map);
+    restorations.add(() -> {
+      map.clear();
+      map.putAll(originalContents);
+    });
+    map.clear();
+    return map;
+  }
+
+  private void replaceField(Class<?> owner, String name, Object replacement) throws Exception {
+    Field field = owner.getDeclaredField(name);
+    field.setAccessible(true);
+    Object original = field.get(null);
+    restorations.add(() -> field.set(null, original));
+    field.set(null, replacement);
+  }
+
+  private static final class FakeLoader implements HeadlessAppLoader {
+    final Set<String> runningScopes = new HashSet<>();
+    final Set<String> invalidatedScopes = new HashSet<>();
+    boolean invalidationResult;
+
+    @Override
+    public void loadApp(Context context, Params params, Runnable alreadyRunning,
+        Consumer<Boolean> callback) {
+      throw new AssertionError("These lifecycle tests must not launch a React context");
+    }
+
+    @Override
+    public boolean invalidateApp(String scope) {
+      invalidatedScopes.add(scope);
+      // A loader record can disappear before the still-live JS context is destroyed.
+      if (invalidationResult) {
+        runningScopes.remove(scope);
+      }
+      return invalidationResult;
+    }
+
+    @Override
+    public boolean isRunning(String scope) {
+      return runningScopes.contains(scope);
+    }
+  }
+
+  @SuppressWarnings("rawtypes")
+  private static final class FakeManager implements TaskManagerInterface {
+    private final String scope;
+
+    FakeManager(String scope) {
+      this.scope = scope;
+    }
+
+    @Override
+    public void registerTask(String name, Class consumerClass, Map<String, Object> options) {
+      throw new AssertionError("Unexpected task registration");
+    }
+
+    @Override
