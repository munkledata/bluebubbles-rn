@@ -0,0 +1,24 @@
+package expo.modules.filesystem.legacy
+
+/** A bounded multipart basename, never a path or a separately staged copy. */
+internal object GatorUploadFilename {
+  fun validate(name: String): String {
+    require(name.length in 1..255 && name != "." && name != "..") { "Invalid Gator multipart filename" }
+    require(name.toByteArray(Charsets.UTF_8).size <= 255) { "Invalid Gator multipart filename" }
+    require(name.none { it <= '\u001f' || it in '\u007f'..'\u009f' || it == '/' || it == '\\' || it == '"' }) {
+      "Invalid Gator multipart filename"
+    }
+    var index = 0
+    while (index < name.length) {
+      val character = name[index]
+      if (Character.isHighSurrogate(character)) {
+        require(index + 1 < name.length && Character.isLowSurrogate(name[index + 1])) { "Invalid Gator multipart filename" }
+        index += 2
+      } else {
+        require(!Character.isLowSurrogate(character)) { "Invalid Gator multipart filename" }
+        index += 1
+      }
+    }
+    return name
+  }
+}
