+package expo.modules.filesystem.legacy
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertThrows
+import org.junit.Test
+
+class GatorUploadFilenameTest {
+  @Test
+  fun `safe names keep their exact UTF8 spelling`() {
+    listOf("original report.pdf", "résumé 📄.pdf", "literal%22.pdf", "a".repeat(251) + ".pdf", "é".repeat(125) + ".pdf").forEach {
+      assertEquals(it, GatorUploadFilename.validate(it))
+    }
+  }
+
+  @Test
+  fun `unsafe names cannot become multipart headers or paths`() {
+    listOf("", ".", "..", "../photo.jpg", "folder/photo.jpg", "folder\\photo.jpg", "bad\r\nname.pdf", "nul\u0000.pdf", "bad\u007f.pdf", "bad\u0085.pdf", "quote\".pdf", "\ud800.pdf", "\udc00.pdf", "a".repeat(252) + ".pdf", "é".repeat(126) + ".pdf").forEach {
+      assertThrows(IllegalArgumentException::class.java) { GatorUploadFilename.validate(it) }
+    }
+  }
+}
