# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Local AI-tool settings and scheduler state; shared .claude/settings.json stays tracked.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# local env files (the example is deliberately safe and tracked)
.env
.env.*
!.env.example

# Firebase config (machine/project-specific; use GOOGLE_SERVICES_JSON for EAS once configured)
google-services.json

# Google Play service-account key (used by `eas submit` — secret, never commit)
play-service-account.json

# Play Store build artifacts (regenerated per release)
*.aab

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# generated coverage output
coverage/

# Local Expo module native build artifacts (regenerated by gradle)
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/
